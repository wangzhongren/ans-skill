                "set": {
                  "阶段": "渲染",
                  "渲染回调": 1
                }
              },
              {
                "title": "预约下一帧",
                "file": "src/pipelines/gameloop/game.loop.ts",
                "symbol": "DefaultGameLoop.scheduleFrame",
                "quote": "this.animationFrameId = requestAnimationFrame(() => {",
                "description": "这里只模拟预约状态，不实际创建浏览器游戏循环。",
                "set": {
                  "阶段": "等待下一帧",
                  "下一帧": "已预约"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "pause-resume",
        "name": "暂停与恢复",
        "description": "展示当前示例源码的真实委派顺序，并标注累计计时清零的问题；不把验证副本中的修复冒充已应用。",
        "scenarios": [
          {
            "id": "current",
            "name": "当前源码 · 含已知问题",
            "inputs": {

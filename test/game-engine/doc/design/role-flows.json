                "symbol": "DefaultGameLoop.resume",
                "quote": "this.timer.start();",
                "description": "恢复路径重新调用 start。这个调用与新会话启动共用同一方法。",
                "set": {
                  "循环状态": "Running"
                },
                "occurrence": 2
              },
              {
                "title": "累计状态被重置",
                "file": "src/services/impl/timer/timer.ts",
                "symbol": "PerformanceTimer.start",
                "quote": "this.elapsedTimeInSeconds = 0;",
                "description": "当前 start 清空累计时间与帧数。示例与既有回归证据一致，属于已知实现问题。",
                "set": {
                  "累计秒数": 0,
                  "帧号": 0,
                  "计时器": "运行"
